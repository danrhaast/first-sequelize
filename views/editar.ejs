<%- include ('partials/header')%>

<div class="container">
    <form action="/atualizar/<%= usuario.id %>" method="POST">
        <label for="nome">Nome:</label>
        <input type="text" name="nome" placeholder="Digite seu nome" value="<%= usuario.nome %>"><br>
    
        <label for="email">Email:</label>
        <input type="text" name="email" placeholder="Digite seu email"  value="<%= usuario.email %>"><br>
    
        <label for="dataNasc">Data de Nascimento:</label>
        <input type="date" name="dataNasc" value="<%= usuario.dataNasc %>"><br>
    
        <label for="senha">Senha:</label>
        <input type="text" name="senha" placeholder="Digite sua senha"  value="<%= usuario.senha %>"><br>
    
        <label for="genero">Gênero:</label>
    
        <label>
            <input type="radio" name="genero" value="masculino" <%= usuario.genero === 'masculino' ? 'checked' : '' %> >
            Masculino
        </label>
    
        <label>
            <input type="radio" name="genero" value="feminino" <%= usuario.genero === 'feminino' ? 'checked' : '' %>>
            Feminino
        </label><br>
    
        <button type="submit">Atualizar</button>
    </form>
</div>
