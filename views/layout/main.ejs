<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <title>TESTES EM NODE COM BANCO DA DADOS</title>

    <style>
        body {
            margin: 0;
            font-family: "Raleway", sans-serif;
            font-optical-sizing: auto;
            font-weight: 400;
            font-style: normal;
        }

        form {
            display: flex;
            flex-direction: column;
            width: 30%;
        }

        input {
            padding: 5px;
            border-radius: 12px;
        }

        label {
            margin-left: 12px;
            margin-bottom: 2px;
        }

        button {
            border: none;
            border-radius: 12px;
            height: 6vh;
            background-color: rgb(70, 70, 255);
            color: aliceblue;
            transition: 0.5s ease;
        }

        button:hover {
            background-color: rgb(120, 120, 252);
        }

        .container {
            margin-top: 50px;
            display: flex;
            justify-content: center;
        }
    </style>
</head>

<body>
    <%- body %>
</body>

</html>